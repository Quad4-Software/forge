{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository new migrate">
	<div class="ui middle very relaxed page grid">
		<div class="column">
			<form class="ui form" action="{{.Link}}" method="post">
				<h3 class="ui top attached header">
					{{ctx.Locale.Tr "repo.migrate.mass_title"}}
				</h3>
				<div class="ui attached segment">
					{{template "base/alert" .}}

					<div class="inline required field">
						<label for="service_type">{{ctx.Locale.Tr "repo.migrate.mass_service"}}</label>
						<select id="service_type" name="service">
							{{range .Services}}
								<option value="{{.}}" {{if eq . $.service}}selected{{end}}>{{.Title}}</option>
							{{end}}
						</select>
						<span class="help">{{ctx.Locale.Tr "repo.migrate.mass_service_desc"}}</span>
					</div>

					<div class="inline field {{if .Err_BaseURL}}error{{end}}">
						<label for="base_url">{{ctx.Locale.Tr "repo.migrate.mass_base_url"}}</label>
						<input id="base_url" name="base_url" value="{{.base_url}}" autocomplete="url" placeholder="https://github.com">
						<span class="help">{{ctx.Locale.Tr "repo.migrate.mass_base_url_desc"}}</span>
					</div>

					<div class="inline required field {{if .Err_Owner}}error{{end}}">
						<label for="owner">{{ctx.Locale.Tr "repo.migrate.mass_owner"}}</label>
						<input id="owner" name="owner" value="{{.owner}}" required autocorrect="off" autocapitalize="none">
						<span class="help">{{ctx.Locale.Tr "repo.migrate.mass_owner_desc"}}</span>
					</div>

					<div class="inline field">
						<label for="owner_type">{{ctx.Locale.Tr "repo.migrate.mass_owner_type"}}</label>
						<select id="owner_type" name="owner_type">
							<option value="auto" {{if eq .owner_type "auto"}}selected{{end}}>{{ctx.Locale.Tr "repo.migrate.mass_owner_type_auto"}}</option>
							<option value="org" {{if eq .owner_type "org"}}selected{{end}}>{{ctx.Locale.Tr "repo.migrate.mass_owner_type_org"}}</option>
							<option value="user" {{if eq .owner_type "user"}}selected{{end}}>{{ctx.Locale.Tr "repo.migrate.mass_owner_type_user"}}</option>
						</select>
					</div>

					<div class="inline field {{if .Err_Auth}}error{{end}}">
						<label for="auth_token">{{ctx.Locale.Tr "access_token"}}</label>
						<input id="auth_token" name="auth_token" type="password" autocomplete="new-password" value="{{.auth_token}}" {{if not .auth_token}}data-need-clear="true"{{end}}>
						<span class="help">{{ctx.Locale.Tr "repo.migrate.mass_token_desc"}}</span>
					</div>

					<div class="inline field">
						<label>{{ctx.Locale.Tr "repo.migrate.mass_include"}}</label>
						<div>
							<div class="ui checkbox">
								<input name="include_forks" type="checkbox" {{if .include_forks}}checked{{end}}>
								<label>{{ctx.Locale.Tr "repo.migrate.mass_include_forks"}}</label>
							</div>
							<div class="ui checkbox">
								<input name="include_archived" type="checkbox" {{if .include_archived}}checked{{end}}>
								<label>{{ctx.Locale.Tr "repo.migrate.mass_include_archived"}}</label>
							</div>
							<div class="ui checkbox">
								<input name="include_private" type="checkbox" {{if .include_private}}checked{{end}}>
								<label>{{ctx.Locale.Tr "repo.migrate.mass_include_private"}}</label>
							</div>
						</div>
					</div>

					{{template "repo/migrate/options" .}}

					<div class="inline field">
						<label>{{ctx.Locale.Tr "migrate.items.label"}}</label>
						<div class="ui checkbox">
							<input name="wiki" type="checkbox" {{if .wiki}}checked{{end}}>
							<label>{{ctx.Locale.Tr "migrate.items.wiki"}}</label>
						</div>
					</div>
					<div id="migrate_items">
						<span class="help">{{ctx.Locale.Tr "repo.migrate.migrate_items_options"}}</span>
						<div class="inline field">
							<label></label>
							<div class="ui checkbox">
								<input name="issues" type="checkbox" {{if .issues}}checked{{end}}>
								<label>{{ctx.Locale.Tr "migrate.items.issues"}}</label>
							</div>
						</div>
						<div class="inline field">
							<label></label>
							<div class="ui checkbox">
								<input name="pull_requests" type="checkbox" {{if .pull_requests}}checked{{end}}>
								<label>{{ctx.Locale.Tr "migrate.items.pull_requests"}}</label>
							</div>
						</div>
						<div class="inline field">
							<label></label>
							<div class="ui checkbox">
								<input name="labels" type="checkbox" {{if .labels}}checked{{end}}>
								<label>{{ctx.Locale.Tr "migrate.items.labels"}}</label>
							</div>
						</div>
						<div class="inline field">
							<label></label>
							<div class="ui checkbox">
								<input name="milestones" type="checkbox" {{if .milestones}}checked{{end}}>
								<label>{{ctx.Locale.Tr "migrate.items.milestones"}}</label>
							</div>
						</div>
						<div class="inline field">
							<label></label>
							<div class="ui checkbox">
								<input name="releases" type="checkbox" {{if .releases}}checked{{end}}>
								<label>{{ctx.Locale.Tr "migrate.items.releases"}}</label>
							</div>
						</div>
					</div>

					<div class="divider"></div>

					<div class="inline required field {{if .Err_Owner}}error{{end}}">
						<label>{{ctx.Locale.Tr "repo.owner"}}</label>
						<div class="ui selection owner dropdown">
							<input type="hidden" id="uid" name="uid" value="{{.ContextUser.ID}}" required>
							<span class="text truncated-item-container" title="{{.ContextUser.Name}}">
								{{ctx.AvatarUtils.Avatar .ContextUser 28 "mini"}}
								<span class="truncated-item-name">{{.ContextUser.ShortName 40}}</span>
							</span>
							{{svg "octicon-triangle-down" 14 "dropdown icon"}}
							<div class="menu" title="{{.SignedUser.Name}}">
								<div class="item truncated-item-container" data-value="{{.SignedUser.ID}}">
									{{ctx.AvatarUtils.Avatar .SignedUser 28 "mini"}}
									<span class="truncated-item-name">{{.SignedUser.ShortName 40}}</span>
								</div>
								{{range .Orgs}}
									<div class="item truncated-item-container" data-value="{{.ID}}" title="{{.Name}}">
										{{ctx.AvatarUtils.Avatar . 28 "mini"}}
										<span class="truncated-item-name">{{.ShortName 40}}</span>
									</div>
								{{end}}
							</div>
						</div>
					</div>

					<div class="inline field">
						<label>{{ctx.Locale.Tr "repo.visibility"}}</label>
						<div class="ui checkbox">
							<input name="private" type="checkbox"
								{{if .IsForcedPrivate}}
									checked disabled
								{{else}}
									{{if .private}}checked{{end}}
								{{end}}>
							<label>{{ctx.Locale.Tr "repo.visibility_helper"}}</label>
						</div>
						{{if .IsForcedPrivate}}
							<span class="help">{{ctx.Locale.Tr "repo.visibility_helper_forced"}}</span>
						{{end}}
						<span class="help">{{ctx.Locale.Tr "repo.visibility_description"}}</span>
					</div>

					<div class="inline field">
						<label></label>
						<button class="ui primary button">
							{{ctx.Locale.Tr "repo.migrate.mass_list"}}
						</button>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
{{template "base/footer" .}}
