# Copy to .env and fill required values.
# openssl rand -hex 32

APP_NAME=Quad4 Forge
APP_SLOGAN=Charcoal. Code. Forge.
DOMAIN=localhost
ROOT_URL=http://localhost:3000/
HTTP_PORT=3000
SSH_PORT=2222
RELEASE_VERSION=dev
FORGE_IMAGE=ghcr.io/quad4-software/forge-rootless:dev

FORGE_DB_NAME=forgejo
FORGE_DB_USER=forgejo
FORGE_DB_PASSWORD=change-me-forge-db

# Embedded ALTCHA (served by Forge at /altcha/challenge)
REQUIRE_CAPTCHA_FOR_LOGIN=false
ALTCHA_HMAC_KEY=change-me-altcha-hmac
ALTCHA_MAX_NUMBER=100000

# Optional external Sentry/GlitchTip DSN (no GlitchTip container in this stack)
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_ENVIRONMENT=production

METRICS_ENABLED=true
