# Copy to .env and fill required values.
# openssl rand -hex 32

APP_NAME=Quad4 Forge
APP_SLOGAN=Coffee. Code. Forge.
DOMAIN=localhost
# Public HTTP URL through RavenGuard (local compose)
ROOT_URL=http://localhost:8080/
HTTP_PORT=8080
SSH_PORT=49393
SSH_HOST_PORT=49393
START_SSH_SERVER=true
RELEASE_VERSION=dev
FORGE_IMAGE=ghcr.io/quad4-software/forge-rootless:dev
RAVENGUARD_IMAGE=ghcr.io/quad4-software/ravenguard:edge
RAVENGUARD_CONFIG_IMAGE=ghcr.io/quad4-software/forge-ravenguard-config:dev

FORGE_DB_NAME=forgejo
FORGE_DB_USER=forgejo
FORGE_DB_PASSWORD=change-me-forge-db
VALKEY_PASSWORD=change-me-valkey

# RavenGuard proxy (min 16 chars)
RG_CHALLENGE_SECRET=change-me-rg-challenge-secret
RG_SANDBOX_MODE=best_effort

# Optional external Sentry/GlitchTip DSN
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_ENVIRONMENT=production

METRICS_ENABLED=true

# Embedded Reticulum node (rngit git transport + LXMF messaging)
RNS_ENABLED=true
RNS_EMAIL_OPTIONAL=true

# Coolify only: domain magic lives on ravenguard (do not add SERVICE_URL_* on forge).
# SERVICE_URL_RAVENGUARD_8080 and SERVICE_FQDN_RAVENGUARD are injected by Coolify.

# Optional Crow CI stack (docker-compose.crow.yml, deploy separately)
# Create a Forge OAuth2 app with redirect ${CROW_HOST}/authorize first.
# CROW_HOST=http://localhost:8001
# FORGEJO_URL=https://forge.example.com
# CROW_FORGEJO_CLIENT=
# CROW_FORGEJO_SECRET=
# CROW_AGENT_SECRET=
# CROW_HTTP_PORT=8001
