# Copy to .env and fill required values.
# openssl rand -hex 32

APP_NAME=Quad4 Forge
APP_SLOGAN=Charcoal. Code. Forge.
DOMAIN=localhost
ROOT_URL=http://localhost:3000/
HTTP_PORT=3000
SSH_PORT=2222
RELEASE_VERSION=dev
FORGE_IMAGE=ghcr.io/quad4-software/forge-rootless:dev

FORGE_DB_NAME=forgejo
FORGE_DB_USER=forgejo
FORGE_DB_PASSWORD=change-me-forge-db

# ALTCHA — embedded (default) or remote (GateCHA / Sentinel / Cloud)
ENABLE_CAPTCHA=true
CAPTCHA_TYPE=altcha
REQUIRE_CAPTCHA_FOR_LOGIN=false
ALTCHA_MODE=embedded
ALTCHA_HMAC_KEY=change-me-altcha-hmac
ALTCHA_CHALLENGE_URL=
ALTCHA_VERIFY_MODE=solution
ALTCHA_MAX_NUMBER=100000

# For remote ALTCHA (Cloud/Sentinel/GateCHA):
# ALTCHA_MODE=remote
# ALTCHA_CHALLENGE_URL=https://your-gatecha.example/api/v1/challenge
# ALTCHA_HMAC_KEY=csec_... or GateCHA site secret
# ALTCHA_VERIFY_MODE=solution
# or ALTCHA_VERIFY_MODE=server_signature for Sentinel spam filter

# GlitchTip / Sentry
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
SENTRY_ENVIRONMENT=production

# docker compose --profile monitoring up -d
GLITCHTIP_PORT=8000
GLITCHTIP_DOMAIN=http://localhost:8000
GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_PASSWORD=change-me-glitchtip-db
GLITCHTIP_SECRET_KEY=change-me-glitchtip-secret
GLITCHTIP_FROM_EMAIL=noreply@localhost
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_ENABLE_REGISTRATION=True

# docker compose --profile altcha-remote up -d
GATECHA_PORT=8088
GATECHA_ADMIN_PASSWORD=change-me-gatecha

METRICS_ENABLED=true
