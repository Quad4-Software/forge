# Seeds RavenGuard Coolify config into a named volume (no host bind mounts).
FROM docker.io/library/busybox:1.37.0@sha256:9db7b59979c38555a39def84a31fb98b5296952f9e3afd4f6f11f05b07adfab0

COPY ravenguard.coolify.toml /seed/ravenguard.coolify.toml
COPY blocklists /seed/blocklists

ENTRYPOINT ["/bin/sh", "-ec", "cp -a /seed/. /config/ && ls -la /config /config/blocklists"]
